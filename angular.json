{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "stock-count-workbench": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/stock-count-workbench",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.json",
            "assets": [{"glob": "**/*", "input": "public"}],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [{"type": "initial", "maximumWarning": "650kb", "maximumError": "1mb"}]
            },
            "development": {"optimization": false, "sourceMap": true, "extractLicenses": false}
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {"buildTarget": "stock-count-workbench:build:production"},
            "development": {"buildTarget": "stock-count-workbench:build:development"}
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
